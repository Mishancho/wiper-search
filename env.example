# ID вашей Google Sheets таблицы
# Получите его из URL таблицы: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# Обновлять поисковый кеш из Google Sheets раз в 3 минуты
SHEETS_REFRESH_SECONDS=180

# Локально: путь к файлу service account key.
# По умолчанию используется service-account-key.json в корне проекта.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account-key.json

# На Render: содержимое service-account-key.json одной JSON-строкой.
# Не добавляйте настоящий ключ в этот файл и не коммитьте его.
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
